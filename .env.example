# URL base de la API (incluye /api). La usan todas las peticiones y el keep-alive
# (ping silencioso a {VITE_API_URL}/health cada 15 minutos).
#
# Recomendado: "/api". En desarrollo lo redirige el proxy de Vite y en producción
# los rewrites de vercel.json hacia Render (misma URL, cookies de sesión first-party).
VITE_API_URL=/api
#
# Alternativa: llamar al backend directamente (requiere COOKIE_SAMESITE=none en el backend):
# VITE_API_URL=https://mi-backend.onrender.com/api

# (Sólo desarrollo) destino del proxy de Vite para /api y /uploads
DEV_API_PROXY=http://localhost:4000
